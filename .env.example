# Copy to .env.local (git-ignored). Used by `npm run media:deploy` / `media:check`.

# The Cloudflare Pages project the media is deployed to.
MEDIA_PAGES_PROJECT=bloom-biotech-media

# Only needed if you did not run `npx wrangler@3 login`:
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Leave unset while developing so media loads from ./public.
# Set it only for `npm run media:check`, or to test the site against the CDN.
# NEXT_PUBLIC_MEDIA_URL=https://bloom-biotech-media.pages.dev
